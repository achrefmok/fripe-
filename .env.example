# FRIPE — modèle de configuration. Copier vers .env.local (ignoré par git).
# En local : `pnpm env:local` remplit ce fichier depuis le Supabase local.
# Ne jamais y mettre les clés d'un autre projet.

# Absente en local, staging ou production ailleurs. Voir docs/variables-environnement.md.
NEXT_PUBLIC_FRIPE_ENV=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…) : visible par le navigateur, protégée par RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : serveur uniquement, jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Jeton du planificateur, 32 caractères au moins (openssl rand -hex 32). Serveur uniquement.
# Sans jeton valable, POST /api/internal/maintenance répond 404. Voir docs/maintenance.md.
MAINTENANCE_TOKEN=

# Relais TURN des Lives (Cloudflare Realtime TURN). Serveur uniquement. Absentes : STUN seul.
# Tableau de bord Cloudflare > Realtime > TURN : créer une clé, puis copier son identifiant et son jeton.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Sinon, relais à identifiants fixes (offre gratuite d'ExpressTURN, sans carte bancaire).
# TURN_URLS : adresses séparées par des virgules, ex. turn:free.expressturn.com:3478,turn:free.expressturn.com:3478?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# Modération automatique des photos et vidéos (contenu sexuel, +18, indices d'IA). Serveur uniquement.
# Sans ces clés, le contenu sexuel n'est PAS détecté. Voir docs/moderation-medias.md.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# true en production : sans service d'analyse joignable, l'envoi du média est refusé.
MEDIA_MODERATION_REQUIRED=
