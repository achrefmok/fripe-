{
  "name": "fripe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-stack.mjs && node scripts/e2e.mjs",
    "test:db": "node scripts/test-stack.mjs && supabase test db --workdir .test-stack",
    "db:start": "supabase start -x vector,logflare,imgproxy,edge-runtime",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --db-url \"postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable\" --schema public > src/types/database.ts",
    "env:local": "node scripts/env-local.mjs",
    "admin:grant": "node --env-file=.env.local scripts/grant-admin.mjs",
    "admin:mfa-reset": "node --env-file=.env.local scripts/reset-admin-mfa.mjs",
    "maintenance:run": "node scripts/run-maintenance.mjs",
    "maintenance:status": "node scripts/run-maintenance.mjs --status",
    "env:check": "node scripts/check-env.mjs",
    "staging:seed": "node scripts/seed-staging.mjs",
    "test:stack": "node scripts/test-stack.mjs",
    "test:stack:stop": "supabase stop --no-backup --workdir .test-stack",
    "db:up": "supabase migration up --local"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@serwist/turbopack": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.13",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
