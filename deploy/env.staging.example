# Variables de FRIPE STAGING, à saisir dans Vercel (environnement Preview ou Production du projet
# staging) et jamais dans le dépôt. Voir docs/variables-environnement.md.
NEXT_PUBLIC_FRIPE_ENV=staging
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secrets : marquer « Sensitive » dans Vercel.
SUPABASE_SECRET_KEY=
MAINTENANCE_TOKEN=
